# VHS configuration for hang-trace terminal demo
Output demo.gif

# Terminal settings
Set FontSize 16
Set Width 960
Set Height 520
Set Padding 25
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 50ms

# Run the demo script
Type "node demo.js"
Sleep 600ms
Enter

# Wait for execution and the 3-second hang warning
Sleep 4.5s

# Pause on the result for clear readability
Sleep 3s
